{
  "manifest_version": 3,
  "name": "DTab 双语助手",
  "description": "在 Chrome 新标签页查看开发资讯，并提供网页翻译、双语对照和侧边栏文本翻译。",
  "version": "0.1.3",
  "permissions": ["alarms", "storage", "activeTab", "scripting", "contextMenus", "downloads", "sidePanel"],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://rebang.open2hub.com/*",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "action": {
    "default_title": "保存为 Markdown"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["translateFloatingButton.js"],
      "run_at": "document_idle"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  }
}
